<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTituloIA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asistente IA"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="27dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consulta sobre inventario"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/edtPreguntaIA"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Escribe tu consulta"/>

        <Button
            android:id="@+id/btnConsultarIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consultar"/>

        <TextView
            android:id="@+id/txtRespuestaIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="La respuesta de IA aparecerá aquí."
            android:paddingTop="24dp"/>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".AgregarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTituloAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_agregar_producto"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="27dp"/>

        <EditText
            android:id="@+id/edtNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/nombre_producto"
            android:inputType="textCapWords"
            android:importantForAutofill="no"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/edtCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/categoria"
            android:inputType="textCapWords"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/edtCantidad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/cantidad"
            android:inputType="number"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/edtPrecio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/precio"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"/>

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guardar_producto"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>
